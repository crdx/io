+func TestAPathSymlinkOutsideTheWorkspaceIsStillRefused(t *testing.T) {
+	workspace := filepath.Join(t.TempDir(), "workspace")
+	outside := workspace + "-outside"
+	for _, directory := range []string{workspace, outside} {
+		if err := os.Mkdir(directory, 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	alias := filepath.Join(workspace, "latest")
+	if err := os.Symlink(outside, alias); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", alias)
+
+	paths := execPaths(workspace)
+	if !slices.Contains(paths, alias) {
+		t.Fatalf("the outside target needs its own grant, got %v", paths)
+	}
+	_, err := sandbox.Run(t.Context(), workspace, "true", sandbox.Policy{
+		Exec:  paths,
+		Write: []string{workspace},
+	})
+	if err == nil || !strings.Contains(err.Error(), "symbolic link") {
+		t.Errorf("got %v, want the unsafe grant to be refused", err)
+	}
+}
